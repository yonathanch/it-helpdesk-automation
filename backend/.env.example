# ============================================================
# IT Help Desk AI Automation — Backend Environment Variables
# ============================================================
# Salin file ini ke `.env` lalu sesuaikan nilai per kebutuhan.

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Untuk Docker Compose: gunakan host "postgres" (service name)
# Untuk lokal: gunakan "localhost"
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5433/helpdesk

# ------------------------------------------------------------
# Redis (Queue & Cache)
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=           # kosongkan jika tidak pakai password

# ------------------------------------------------------------
# MinIO / S3 (File Storage untuk attachment)
# ------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=helpdesk-attachments

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
# PENTING: Ganti secret ini di production! Gunakan string random panjang.
# Generate: `openssl rand -base64 32` atau `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
JWT_SECRET=ubah-secret-ini-di-produksi-gunakan-random-string-panjang
JWT_REFRESH_SECRET=ubah-refresh-secret-ini-juga-dengan-string-random-berbeda
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# LLM Provider (AI Triage, Chat, Draft Reply)
# ------------------------------------------------------------
# Provider: openai | anthropic | gemini | mock
# mock = mode testing tanpa API call (tidak butuh API key)
LLM_PROVIDER=mock
LLM_API_KEY=

# Untuk production, pilih salah satu:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...                          # OpenAI API key

# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...                      # Anthropic Claude API key

# LLM_PROVIDER=gemini
# LLM_API_KEY=...                             # Google Gemini API key

# ------------------------------------------------------------
# Embedding Provider (RAG Knowledge Base)
# ------------------------------------------------------------
# Provider: openai | mock
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=

# Untuk production dengan RAG semantic search:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-...                    # OpenAI API key (text-embedding-ada-002)

# ------------------------------------------------------------
# CORS Origins (Frontend URLs yang diizinkan)
# ------------------------------------------------------------
# Pisahkan multiple origins dengan koma (no spaces)
# Development lokal: http://localhost:3001
# Production: tambahkan domain production, misal: https://helpdesk.yourcompany.com
CORS_ORIGINS=http://localhost:3001

# ------------------------------------------------------------
# Email Notifications (Optional)
# ------------------------------------------------------------
# Kosongkan SMTP_HOST untuk disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@helpdesk.local
SMTP_FROM_NAME=IT Help Desk

# Contoh Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password              # Gunakan App Password, bukan password akun
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=IT Help Desk

# ------------------------------------------------------------
# Webhook Integrations (Optional)
# ------------------------------------------------------------
# Kosongkan untuk disable. Sistem akan kirim notifikasi tiket ke webhook.
WEBHOOK_SLACK_URL=
WEBHOOK_TEAMS_URL=
WEBHOOK_WHATSAPP_URL=
WHATSAPP_TO=                                   # Nomor WhatsApp target (format: 62812...)

# Contoh Slack:
# WEBHOOK_SLACK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Contoh Microsoft Teams:
# WEBHOOK_TEAMS_URL=https://yourcompany.webhook.office.com/webhookb2/...

# ------------------------------------------------------------
# Swagger API Docs
# ------------------------------------------------------------
# Set false untuk disable Swagger UI di production (keamanan)
SWAGGER_ENABLED=true

# ------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development                           # development | production

# ------------------------------------------------------------
# Rate Limiting (Anti-Spam)
# ------------------------------------------------------------
# TTL (time-to-live) dalam detik untuk rate limit window
THROTTLE_TTL=60
# Jumlah maksimal request per TTL window (60 req/menit = 1 req/detik)
THROTTLE_LIMIT=60
