# === Server ===
PORT=3000
NODE_ENV=development

# === Database ===
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5433/helpdesk

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === MinIO / S3 ===
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=helpdesk-attachments

# === Auth ===
JWT_SECRET=ganti-dengan-secret-acak-di-produksi
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-lain-di-produksi
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === AI (Milestone 2) ===
# === Embedding (RAG) ===
EMBEDDING_PROVIDER=mock # openai|mock
EMBEDDING_API_KEY=

LLM_PROVIDER=mock # ganti: openai|claude|gemini|ollama|mock (mock = dev tanpa API key)
LLM_API_KEY=

# CORS origins untuk frontend Next.js (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3001

# === Webhook (M4-2) — isi URL kanal bila ingin aktif ===
WEBHOOK_SLACK_URL=
WEBHOOK_TEAMS_URL=
WEBHOOK_WHATSAPP_URL=
WHATSAPP_TO=
